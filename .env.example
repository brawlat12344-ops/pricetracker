# Скопируйте в .env и замените секреты
POSTGRES_DB=pricetracker
POSTGRES_USER=ptuser
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Минимум 32 байта: [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
JWT_SECRET=replace-with-a-long-random-string-at-least-32-bytes
ACCESS_TOKEN_TTL_MINUTES=120

# mock — стабильные демо-характеристики; html — JSON-LD/meta/эвристики со страницы
SPEC_PROVIDER=mock

# Кэш отчётов и цепь размыкания для магазинов (значения по умолчанию)
CACHE_TTL_MINUTES=12
CACHE_MAX_ENTRIES=200
BREAKER_FAILURE_THRESHOLD=3
BREAKER_COOLDOWN_SECONDS=60

# Внешние порты. Внутренние адреса сервисов заданы в docker-compose.yml:
# gateway -> CATALOG_URL=http://catalog:8081, catalog -> PRICE_URL=http://price:8082
APP_PORT=80
GATEWAY_PORT=8080
CATALOG_PORT=8081
PRICE_PORT=8082
